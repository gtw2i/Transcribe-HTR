# Transcribe-HTR — example environment configuration.
# Copy to `.env` and fill in the values you need. Every variable is optional;
# API keys can also be entered in the UI at runtime instead of being set here.
#
#   cp .env.example .env
#
# NEVER commit your real .env — it is gitignored.

# ── Provider API keys ────────────────────────────────────────────────────────
# At least one is required to transcribe anything. The default provider is
# Gemini (PROVIDER_DEFAULT in backend/core/config.py).
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# ── Session security ─────────────────────────────────────────────────────────
# Signs the session cookie. If unset, a random key is generated at startup,
# which invalidates all existing sessions on every restart. Set it in any
# deployment:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# Skip loading the spaCy NER model (saves ~500MB RAM). Required on small VMs.
SPACY_ENABLED=true

# Backend text-to-speech flag. Note the TTS tab is also hard-disabled in the UI
# via frontend/src/featureFlags.js (TTS_UI_ENABLED), which takes precedence.
VERBALIZE_ENABLED=true

# Automatically retry a failed call against the next model/provider in the
# fallback chain (backend/core/fallback.py).
MODEL_FALLBACK_ENABLED=true
