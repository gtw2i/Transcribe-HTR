    name-particle: F.
version: "2.0.0"
date-released: 2026-07-29
license: BSD-2-Clause
repository-code: "https://github.com/gtw2i/Transcribe-HTR"
keywords:
  - historical document transcription
  - handwritten text recognition
  - AI vision models
  - manuscript analysis
  - digital humanities
